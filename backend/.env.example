# Copy this file to backend/.env and fill in your values. backend/.env is never committed (see .gitignore).
# On the server, put these lines in /etc/flowdeck/flowdeck.env instead, then: sudo systemctl restart flowdeck

# Razorpay (Dashboard > Account & Settings > API Keys). Test keys start with rzp_test_, live keys with rzp_live_.
# The secret stays on the server; the browser only ever gets the key id.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Email for password resets and new sign-in alerts (see backend/app/mailer.py). Any SMTP provider works; with Resend:
# verify your domain at resend.com, create an API key, and use it as the password.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx
# MAIL_FROM=Flowdeck <no-reply@flowdeck.site>
# Links in emails point here. On your own PC: http://127.0.0.1:8000
# FLOWDECK_SITE_URL=https://flowdeck.site
